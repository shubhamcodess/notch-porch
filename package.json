{
  "name": "notch-porch",
  "productName": "Notch Porch",
  "version": "1.6.0",
  "description": "A widget dock that lives in the MacBook notch. Starts with a YouTube Music widget; more are easy to add.",
  "author": "Shubham Prakash",
  "license": "MIT",
  "homepage": "https://github.com/shubhamcodess/notch-porch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shubhamcodess/notch-porch.git"
  },
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/build-native.js --silent || true",
    "start": "electron .",
    "build:native": "node scripts/build-native.js",
    "dist": "npm run build:native && electron-builder --mac --arm64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.0.0",
    "cross-fetch": "^4.0.0",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.shubhamcodess.notchporch",
    "productName": "Notch Porch",
    "artifactName": "Notch-Porch-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "widgets/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true
      },
      "extraResources": [
        {
          "from": "build/menubar-watch",
          "to": "menubar-watch"
        }
      ]
    },
    "dmg": {
      "title": "Notch Porch"
    },
    "afterPack": "scripts/adhoc-sign.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Notch-Porch-Setup-${arch}.${ext}",
      "shortcutName": "Notch Porch"
    }
  }
}
